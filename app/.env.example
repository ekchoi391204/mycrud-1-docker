# Published ports
FRONT_PORT=8080
API_PORT=8000
MYSQL_EXPOSED_PORT=3306

# API
SERVER_NAME=api.cloud.local
SERVER_IP=
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Initial account (created only when it does not exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# MySQL 8.0
MYSQL_HOST=db.cloud.local
MYSQL_PORT=3306
MYSQL_DATABASE=frodo
MYSQL_USER=frodo
MYSQL_PASSWORD=CHANGE_ME_MYSQL_APP_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

# Redis session store
REDIS_HOST=redis.cloud.local
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
REDIS_SESSION_PREFIX=crud:session:
